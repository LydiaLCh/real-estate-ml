   "source": [
    "#Extracting date / time features in order to capture the time-dependent factors affecting housing prices: \n",
    "# Year: captures long term trends, Month: captures seasonality, Day of the week: can capture weekday/weekend effects, Quarter: asummary of seasonality by quarters, Day of year: more granular seasonal patterns\n",
    "\n",
    "df[\"Year\"] = df[\"Date\"].dt.year\n",
    "df[\"Month\"] = df[\"Date\"].dt.month\n",
    "df[\"DayOfWeek\"] = df[\"Date\"].dt.dayofweek\n",
    "df[\"DayOfWeek\"] += 1\n",
    "df[\"Quarter\"] = df[\"Date\"].dt.quarter\n",
    "df[\"DayOfYear\"] = df[\"Date\"].dt.dayofyear\n",
    "\n",
    "#Overwrite the original dataframe with the new one, filtering out any data from years before 2024\n",
    "df = df[df[\"Year\"].isin([2024,2025])]\n",
    "\n",
    "#Group by Year + x time unit to analyse price variations by any of the time units wihtin each year separately\n",
    "\n",
    "# Year-Month \n",
    "df['YearMonth'] = df['Date'].dt.to_period('M')\n",
    "\n",
    "# Year-Quarter \n",
    "df['YearQuarter'] = df['Year'].astype(str) + '-Q' + df['Quarter'].astype(str)\n",
    "\n",
    "# Year-DayOfWeek \n",
    "df['YearDayOfWeek'] = df['Year'].astype(str) + '-D' + df['DayOfWeek'].astype(str)\n",
    "\n",
    "# Year-DayOfYear \n",
    "df['YearDayOfYear'] = df['Year'].astype(str) + '-Day' + df['DayOfYear'].astype(str)\n"
   ]
  },
