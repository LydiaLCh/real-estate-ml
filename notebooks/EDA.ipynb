   "source": [
    "#Handling missing data\n",
    " \n",
    "#Calculate missing percentage for each column \n",
    "missing_percent = df.isnull().mean() #mean() gives fraction of missing per column \n",
    "\n",
    "#Select columns with less thna 50% missing values\n",
    "cols_to_impute = missing_percent[missing_percent < 0.5].index.tolist()\n",
    "\n",
    "#Drop columns with missing values > 50%\n",
    "df = df[cols_to_impute]\n",
    "\n",
    "#Impute missing values with median for selected columns for numeric and string types separately \n",
    "for col in cols_to_impute: \n",
    "    if pd.api.types.is_numeric_dtype(df[col]): \n",
    "        df[col] = df[col].fillna(df[col].median())\n",
    "    else: \n",
    "        df[col] = df[col].fillna(df[col].mode()[0])\n",
    "\n",
    "df \n"
   ]
  }
